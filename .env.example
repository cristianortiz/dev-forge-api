# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SERVER_HOST=0.0.0.0
SERVER_PORT=9000

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dev_forge
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_INTERVAL=1m

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Zitadel (fill in after running Zitadel console setup) ────────────────────
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_CLIENT_ID=

# ── Go modular monolith blueprint seed (required only for `make seed`) ─────────
# Use a GitHub template repository snapshot that passed the publication gates.
BLUEPRINT_SOURCE_REPOSITORY=
BLUEPRINT_SOURCE_COMMIT=

# ── OTEL ──────────────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=dev-forge
# The current application still reads this variable; the resource attributes
# and exporters below will be wired up in the later instrumentation phases.
OTEL_SERVICE_VERSION=0.1.0
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0,deployment.environment.name=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=10000
