          {
            "matcher": {
              "id": "byName",
              "options": "http_response_status_code"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "HTTP"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "http_route"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Endpoint"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 12,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Requests"
          }
        ]
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "round(sum by (http_response_status_code, http_route) (label_replace(increase(http_server_request_duration_seconds_count{service_name=\"dev-forge\",http_response_status_code=~\"4..|5..\"}[$__range]), \"http_route\", \"unmatched\", \"http_route\", \"^$\"))) > 0",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Errores HTTP por status y endpoint",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "One enriched access log per failed HTTP request, including status, route, error_code, response message, and an underlying cause when available. 4xx stay WARN and 5xx stay ERROR.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "id": 13,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "direction": "backward",
          "editorMode": "code",
          "expr": "{service_name=\"dev-forge\"} | status=~\"${httpStatus:raw}\" | method!=\"\" | line_format \"{{if .route}}{{.method}} {{.route}}{{else}}{{.method}} unmatched route{{end}} status={{.status}}{{if .error_code}} code={{.error_code}}{{end}}{{if .error_message}} {{.error_message}}{{end}}{{if and .exception_message (ne .exception_message .error_message)}} ({{.exception_message}}){{end}}\" |= ${logSearch:doublequote} | drop code_file_path, code_function_name, code_line_number, code_stacktrace, observed_timestamp, scope_name, telemetry_sdk_language, telemetry_sdk_name, telemetry_sdk_version, flags",
          "maxLines": 100,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Requests fallidas · 4xx/5xx",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Eventos de diagnóstico de aplicación que no corresponden a una request HTTP. Los detalles de errores HTTP están consolidados en el panel anterior.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 55
      },
      "id": 11,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "direction": "backward",
          "editorMode": "code",
          "expr": "{service_name=\"dev-forge\"} | severity_text=~\"${severity:raw}\" | method=\"\" | line_format \"{{.severity_text}} {{.error_code}} {{.exception_message}}\" |= ${logSearch:doublequote} | drop code_file_path, code_function_name, code_line_number, code_stacktrace, observed_timestamp, scope_name, telemetry_sdk_language, telemetry_sdk_name, telemetry_sdk_version, flags",
          "maxLines": 200,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Diagnósticos de plataforma · DEBUG/WARN/ERROR",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "dev-forge",
